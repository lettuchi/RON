{
  "_comment": "Copy to .cursor/mcp.json (same folder). Set MESHY_API_KEY to your msy_ key from https://www.meshy.ai/settings/api, or paste the value from scripts/.env. Restart Cursor and enable the meshy MCP server. Do not commit real keys.",
  "mcpServers": {
    "meshy": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@meshy-ai/meshy-mcp-server"],
      "env": {
        "MESHY_API_KEY": "REPLACE_WITH_YOUR_KEY"
      }
    }
  }
}
