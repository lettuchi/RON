# Copy to scripts/.env and fill in values. Never commit scripts/.env.

# ElevenLabs — voice, music (see scripts/generate_*.py)
ELEVENLABS_API_KEY=

# Legacy character voices (generate_voice.py / generate_narrator_voice.py)
# ELEVENLABS_VOICE_TOA=l32B8XDoylOsZKiSdfhE
# ELEVENLABS_VOICE_KAORU=iB0m5bo5Htdz0t9yE0xq
# ELEVENLABS_VOICE_NARRATOR=AeRdCCKzvd23BpJoofzx

# v2 pass only (regenerate_voice_with_metadata.py)
ELEVENLABS_VOICE_V2_TOA=Ylb1ch6nQEKvpaUivWj6
ELEVENLABS_VOICE_V2_KAORU=zyxAdkuEJWvr177AyQPs
# Optional v2 narrator voice (regenerate_voice_with_metadata.py): giAoKpl5weRTCJK7uB9b
ELEVENLABS_VOICE_V2_NARRATOR=giAoKpl5weRTCJK7uB9b
# Batch TTS model: v2 is default for legacy compatibility; v3 required for [audio tags].
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=eleven_v3

# NovelAI — image CG generation (see scripts/generate_novelai_image.py)
# Persistent API token: NovelAI → User Settings → Persistent API tokens
NOVELAI_API_KEY=
# Optional reference only (not required by generate_novelai_image.py)
NOVELAI_ACCOUNT_ID=

# Meshy — image-to-3D for character refs (see scripts/meshy_image_to_3d.py, docs/meshy-setup.md)
# Get key at https://www.meshy.ai/settings/api (Pro plan may be required for API)
MESHY_API_KEY=msy_your_key_here

# fal.ai — image-to-video for the cel trailer (see scripts/generate_video_clip.py)
# Get key at https://fal.ai/dashboard/keys  (format: "<key_id>:<key_secret>")
FAL_KEY=
